# Copy to `.env` (git-ignored) and fill in. Read by `python3 run.py` / the local server at start-up; a variable already set in the
# shell wins over this file. On Vercel set the same names under Project Settings -> Environment Variables (the file is not deployed).

# CAS Common Chemistry API token (https://commonchemistry.cas.org/api-overview -> "API Access Request Form", free; data is CC BY-NC).
# Without it the CAS source is off; PubChem and NIST keep working.
CAS_API_KEY=

# Optional. Set to 0 to switch the NIST WebBook lookups off (NIST SRD terms: per-user retrieval, no redistribution; consider it for a
# public deployment).
# RC_NIST=1

# Optional. Requests per client address per minute on a hosted deployment (default 40).
# RC_RATE_PER_MIN=40
